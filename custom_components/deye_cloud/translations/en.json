{
  "config": {
    "step": {
      "user": {
        "title": "Deye Cloud",
        "description": "Enter your Deye Cloud developer credentials. Create an app at developer.deyecloud.com.",
        "data": {
          "region": "Region",
          "app_id": "App ID",
          "app_secret": "App Secret",
          "email": "Account email",
          "password": "Account password"
        }
      },
      "reauth_confirm": {
        "title": "Deye Cloud",
        "description": "The Deye Cloud rejected the stored credentials for {email}. Enter the current app secret and account password.",
        "data": {
          "app_secret": "App Secret",
          "password": "Account password"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect. Check your credentials, app ID/secret and region.",
      "invalid_auth": "Those credentials were rejected by the Deye Cloud."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "reauth_successful": "Deye Cloud credentials updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "description": "Deye loggers upload to the cloud every 3-5 minutes, and the API is quota limited. Lower intervals mean fresher data and more API calls.",
        "data": {
          "scan_interval": "Measurement poll interval (seconds)",
          "config_interval": "Inverter settings poll interval (minutes)"
        }
      }
    }
  },
  "exceptions": {
    "no_device_data": {
      "message": "Deye Cloud listed devices but returned no data for them; retrying."
    },
    "unknown_device": {
      "message": "Unknown inverter: {device_sn}"
    },
    "no_devices": {
      "message": "No Deye devices are set up yet."
    },
    "device_sn_required": {
      "message": "Multiple Deye devices are configured; set device_sn to pick one."
    },
    "tou_not_read": {
      "message": "The Time Of Use table has not been read from the inverter yet. Give every slot all of time, power, batt, grid_charge and gen, or try again after the next update."
    },
    "command_rejected": {
      "message": "The inverter rejected {name}: {error}"
    },
    "value_rejected": {
      "message": "The inverter rejected {name} = {value}: {error}"
    },
    "unknown_option": {
      "message": "{option} is not an option of {name}."
    },
    "tou_time_step": {
      "message": "TOU slot {slot} time {time} has to be on a 5-minute step (e.g. 06:00, 06:05)."
    },
    "tou_time_after": {
      "message": "TOU slot {slot} time {time} has to be later than the previous slot ({other})."
    },
    "tou_time_before": {
      "message": "TOU slot {slot} time {time} has to be earlier than the next slot ({other})."
    },
    "auth_failed": {
      "message": "Deye Cloud rejected the login: {error}"
    },
    "rate_limited": {
      "message": "Rate limited by Deye Cloud; polling every {seconds}s until it clears: {error}"
    },
    "update_failed": {
      "message": "Could not read from Deye Cloud: {error}"
    }
  },
